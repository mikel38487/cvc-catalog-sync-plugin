# Зависимости (npm ci ставит их из package-lock.json).
node_modules/
coverage/

# Логи и отладочные файлы.
*.log
npm-debug.log*

# Локальные настройки и мусор редакторов.
.env
.env.*
*.bak
*.bak-*
.DS_Store
Thumbs.db

# Собранные локально тарболы (npm pack без --dry-run).
*.tgz

# Снимки исходных плагинов на время слияния — только локально.
_src-*/

# Черновики рабочей папки, к плагину не относятся.
_dsh-settings-source.txt
_ui-settings-plugins-README.txt

# client.js намеренно НЕ игнорируется: артефакт сборки коммитится, иначе
# git-установка и проверка «собранное совпадает с коммитом» в CI ломаются.

# Внутренние документы работы, не для публикации
REVIEW-*.md
_release-notes-*.md

