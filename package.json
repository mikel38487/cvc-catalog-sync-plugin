{
  "name": "cvc-catalog-sync-plugin",
  "version": "1.0.0",
  "description": "DSH plugin: keeps the CheapVibeCode model catalog in the profile patch in sync with /v1/models and the reasoning levels from the official installer, with a settings page in the DSH UI",
  "type": "module",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "dsh-plugin",
    "cheapvibecode",
    "model-catalog",
    "reasoning-levels"
  ],
  "author": "mikel38487",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikel38487/cvc-catalog-sync-plugin.git"
  },
  "homepage": "https://github.com/mikel38487/cvc-catalog-sync-plugin#readme",
  "bugs": {
    "url": "https://github.com/mikel38487/cvc-catalog-sync-plugin/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/self-test.mjs test/integration.mjs test/settings-api.mjs test/client-render.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "engines": {
      "dsh": ">=0.2.2-rc.3 <0.4.0"
    }
  }
}
